rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Prompt Images: Publicly readable by everyone, upload/delete only by Admin
    match /prompts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.token.email == 'nikhildswll@gmail.com'
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.email == 'nikhildswll@gmail.com';
    }
  }
}
